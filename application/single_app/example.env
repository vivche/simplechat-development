# Azure Cosmos DB
# Use connection string OR endpoint/key OR managed identity
# e.g., https://mycosmosdb.documents.azure.com:443/
AZURE_COSMOS_ENDPOINT="<your-cosmosdb-account-uri>"
# Options: "key", "connection_string", "managed_identity"
AZURE_COSMOS_AUTHENTICATION_TYPE="key"
# if using key, then populate the following:
AZURE_COSMOS_KEY="<your-cosmosdb-primary-key>"


# Azure AD Authentication (Required)
CLIENT_ID="<your-app-registration-client-id>"
TENANT_ID="<your-azure-ad-tenant-id>"
# SECRET_KEY should be a long, random, secret string (e.g., 32+ chars) used for Flask session signing. Generate one securely.
SECRET_KEY="Generate-A-Strong-Random-Secret-Key-Here!"
# AZURE_ENVIRONMENT: Set based on your cloud environment
# Options: "public", "usgovernment", "custom"
AZURE_ENVIRONMENT="public"

# Optional Graph overrides (for cross-cloud identity/Graph scenarios)
# Example values:
# CUSTOM_GRAPH_URL_VALUE="https://graph.microsoft.com"
# CUSTOM_GRAPH_AUTHORITY_URL_VALUE="https://login.microsoftonline.com"

# Chief of Staff Runtime (external agent runtime) integration — Agent Builder
# SimpleChat proxies Agent Builder calls to the runtime, forwarding a runtime-audience token.
# Prereq: SimpleChat's app registration must have delegated permission to the runtime's
# access_as_user scope (admin-consented). See docs/chief_of_staff_runtime_integration.md.
# ENABLE_COS_RUNTIME_AGENTS: turn the /cos-agents page + /api/cos/* proxy on
ENABLE_COS_RUNTIME_AGENTS="false"
# COS_RUNTIME_BASE_URL: runtime API base URL (include the /api suffix for Functions)
# COS_RUNTIME_BASE_URL="https://func-cos-runtime-dev.azurewebsites.us/api"
# COS_RUNTIME_SCOPE: the runtime app's exposed scope
# COS_RUNTIME_SCOPE="api://<runtime-client-id>/access_as_user"
# COS_RUNTIME_TIMEOUT_SECONDS: per-request timeout to the runtime
# COS_RUNTIME_TIMEOUT_SECONDS="30"

# AI Chief of Staff (POC) — Microsoft Graph briefing window/limits
# Only used when the 'chief_of_staff_data_source' setting is set to 'graph'.
# All optional; each falls back to the default below if unset, non-numeric, or non-positive.
# GRAPH_LOOKBACK_HOURS: how far back to scan mail/Teams (hours)
# GRAPH_LOOKBACK_HOURS="48"
# GRAPH_LOOKAHEAD_HOURS: how far forward to scan the calendar (hours)
# GRAPH_LOOKAHEAD_HOURS="48"
# GRAPH_MAX_EMAILS: max messages fetched
# GRAPH_MAX_EMAILS="15"
# GRAPH_MAX_MEETINGS: max calendar events fetched
# GRAPH_MAX_MEETINGS="10"
# GRAPH_MAX_CHATS: max chats scanned for Teams messages
# GRAPH_MAX_CHATS="5"
# GRAPH_MAX_MESSAGES_PER_CHAT: max messages read per chat
# GRAPH_MAX_MESSAGES_PER_CHAT="5"